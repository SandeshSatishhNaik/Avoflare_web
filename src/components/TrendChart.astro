---
// EGT divergence over the 2 h mission at three simulated wear severities. One hue, light to dark = low to high severity.
import trend from '../data/trend.json';
const W = 720, H = 300, P = { l: 46, r: 110, t: 18, b: 36 };
const T = 7200, YM = 12;
const x = (t: number) => P.l + (t / T) * (W - P.l - P.r);
const y = (v: number) => P.t + (1 - Math.max(0, v) / YM) * (H - P.t - P.b);
const shades = ['#9cc0e6', '#5e90c8', '#2f62a0'];
const lines = trend.map((s, i) => ({
  ...s,
  color: shades[i],
  d: s.points.filter(p => p[1] != null).map((p, k) => `${k ? 'L' : 'M'}${x(p[0]).toFixed(1)},${y(p[1] as number).toFixed(1)}`).join(''),
  end: s.points.filter(p => p[1] != null).at(-3) as [number, number],
}));
---
<figure class="static-chart">
  <figcaption>EGT above the healthy twin at three levels of simulated turbocharger compressor wear <span class="muted">(°C, 2 h mission)</span></figcaption>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Divergence grows with wear: peak ${lines.map(l => `${l.severity} % wear ${l.maxDeltaEgt} °C`).join(', ')}.`}>
    {[0, 3, 6, 9, 12].map(v => (
      <g><line x1={P.l} x2={W - P.r} y1={y(v)} y2={y(v)} class="g" /><text x={P.l - 8} y={y(v) + 4} class="a" text-anchor="end">{v}</text></g>
    ))}
    {[0, 1800, 3600, 5400, 7200].map(t => (
      <text x={x(t)} y={H - 10} class="a" text-anchor="middle">{`${String(Math.floor(t / 3600)).padStart(2, '0')}:${String((t % 3600) / 60).padStart(2, '0')}`}</text>
    ))}
    <line x1={x(3600)} x2={x(3600)} y1={P.t} y2={H - P.b} class="onset" />
    <text x={x(3600) + 6} y={P.t + 12} class="a">wear starts</text>
    {lines.map(l => (
      <g>
        <path d={l.d} fill="none" stroke={l.color} stroke-width="2.25" stroke-linejoin="round" />
        <text x={W - P.r + 8} y={y(l.end[1]) + 4} class="lbl">{l.severity} % · {l.maxDeltaEgt} °C</text>
      </g>
    ))}
  </svg>
  <details>
    <summary>Show as a table</summary>
    <table class="data-table num">
      <thead><tr><th>Wear severity</th><th>Peak EGT above twin</th><th>Peak CHT change</th><th>Simulated UAV</th></tr></thead>
      <tbody>{trend.map(s => <tr><td>{s.severity} %</td><td>{s.maxDeltaEgt} °C</td><td>−{s.maxDeltaCht} °C</td><td>{s.uav}</td></tr>)}</tbody>
    </table>
  </details>
</figure>
<style>
  .static-chart { margin: 0; }
  .static-chart figcaption { font-size: 0.95rem; color: var(--ink-2); margin-bottom: var(--s-3); }
  .static-chart svg { width: 100%; height: auto; }
  .g { stroke: var(--line); }
  .a { fill: var(--ink-3); font-family: var(--font-mono); font-size: 11px; }
  .onset { stroke: var(--ink-3); stroke-dasharray: 3 4; }
  .lbl { fill: var(--ink); font-family: var(--font-mono); font-size: 11px; }
  details { margin-top: var(--s-3); }
  summary { cursor: pointer; color: var(--ink-2); min-height: 44px; display: flex; align-items: center; }
</style>
