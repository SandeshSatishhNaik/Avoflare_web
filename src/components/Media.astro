---
// Full-bleed background media: a graded video (id from public/media/v) or a still (id from public/media/img).
// Videos autoplay only while visible (motion.js) and stay on their poster under reduced motion.
interface Props { video?: string; img?: string; alt?: string; scrim?: 'bottom' | 'left' | 'full' | 'none'; kenburns?: boolean; eager?: boolean; class?: string; parallax?: boolean }
const { video, img, alt = '', scrim = 'bottom', kenburns = false, eager = false, class: cls = '', parallax = false } = Astro.props;
const classes = ['media', scrim !== 'none' && `scrim-${scrim}`, kenburns && 'kenburns', cls].filter(Boolean).join(' ');
---
<div class={classes} data-parallax={parallax ? '' : undefined}>
  {video ? (
    <video data-auto muted loop playsinline preload={eager ? 'auto' : 'none'} poster={`/media/v/${video}.webp`} aria-hidden="true">
      <source src={`/media/v/${video}-720.mp4`} type="video/mp4" media="(max-width: 820px)" />
      <source src={`/media/v/${video}.mp4`} type="video/mp4" />
    </video>
  ) : img && (
    <img src={`/media/img/${img}-2400.webp`} srcset={`/media/img/${img}-1200.webp 1200w, /media/img/${img}-2400.webp 2400w`} sizes="100vw"
      alt={alt} width="2400" height="1350" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
  )}
</div>
