---
import Icon from './Icon.astro';
interface Props { status: 'impl' | 'partial' | 'design' | 'gap' }
const { status } = Astro.props;
const map = {
  impl: { label: 'Implemented', icon: 'check-circle' },
  partial: { label: 'Partly implemented', icon: 'circle-half' },
  design: { label: 'Designed', icon: 'circle-dashed' },
  gap: { label: 'Not yet', icon: 'x' },
} as const;
const m = map[status];
---
<span class={`stamp stamp-${status === 'impl' ? 'impl' : status}`}><Icon name={m.icon} />{m.label}</span>
