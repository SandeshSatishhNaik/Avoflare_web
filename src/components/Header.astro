---
import { nav } from '../data/site.js';
import Icon from './Icon.astro';
interface Props { theme: 'dark' | 'light' }
const { theme } = Astro.props;
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="AVOFLARE home">
      <img src={theme === 'dark' ? '/brand/mark-on-dark.png' : '/brand/mark-128.png'} alt="" width="46" height="30" />
      <span>AVOFLARE</span>
    </a>
    <button class="btn menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">
      <Icon name="list" /> Menu
    </button>
    <nav class="nav" id="site-nav" aria-label="Main">
      <ul>
        {nav.map(n => (
          <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nav = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    nav?.toggleAttribute('data-open', open);
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && nav?.hasAttribute('data-open')) {
      nav.removeAttribute('data-open');
      btn?.setAttribute('aria-expanded', 'false');
      btn?.focus();
    }
  });
</script>
