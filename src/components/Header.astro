---
import { nav } from '../data/site.js';
const path = Astro.url.pathname;
const quick = nav.filter(n => ['/how-it-works/', '/fault-response/', '/demo/'].includes(n.href));
---
<header class="site-header theme-dark" data-header>
  <div class="wrap">
    <a class="brand" href="/" aria-label="AVOFLARE home">
      <img src="/brand/mark-on-dark.png" alt="" width="46" height="28" />
      <span>AVOFLARE</span>
    </a>
    <nav class="quick-nav" aria-label="Quick links">
      <ul>{quick.map(n => <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>)}</ul>
    </nav>
    <button class="menu-btn" type="button" aria-haspopup="dialog" aria-controls="site-menu" data-menu-open>
      <span>Menu</span><span class="ring" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>
<dialog class="menu theme-dark" id="site-menu" aria-label="Site menu">
  <div class="menu-media" aria-hidden="true"><img src="/media/v/reel-clouds.webp" alt="" loading="lazy" /></div>
  <div class="menu-inner wrap">
    <div class="menu-top">
      <a class="brand" href="/"><img src="/brand/mark-on-dark.png" alt="" width="46" height="28" /><span>AVOFLARE</span></a>
      <button class="menu-btn" type="button" data-menu-close><span>Close</span><span class="ring" aria-hidden="true"><i style="rotate:45deg;translate:0 3.2px"></i><i style="rotate:-45deg;translate:0 -3.2px"></i></span></button>
    </div>
    <nav aria-label="Main">
      <ol class="menu-list">
        <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
        {nav.map(n => <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
      </ol>
    </nav>
    <div class="menu-foot"><span>Problem Statement 26054 · engine digital twin for a MALE UAV</span><span>Imagery: AI-generated · Data: simulated</span></div>
  </div>
</dialog>
<script>
  const menu = document.getElementById('site-menu') as HTMLDialogElement;
  const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  opener?.addEventListener('click', () => { menu.showModal(); (window as any).__lenis?.stop(); });
  document.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());
  menu.addEventListener('close', () => { (window as any).__lenis?.start(); opener?.focus(); });

  // Header turns solid once the hero is passed, hides on scroll down, returns on scroll up.
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  let last = 0;
  const onScroll = () => {
    const y = window.scrollY;
    header.classList.toggle('is-solid', y > 40);
    header.classList.toggle('is-hidden', y > 400 && y > last + 4);
    if (y < last - 4) header.classList.remove('is-hidden');
    last = y;
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
