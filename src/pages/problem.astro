---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Stamp from '../components/Stamp.astro';
import Term from '../components/Term.astro';
import Icon from '../components/Icon.astro';
import { coverage, sensors, faults } from '../data/site.js';
---
<Base title="Problem" description="Problem Statement 26054 and where AVOFLARE covers each requirement: digital twin, health monitoring, fault prediction, AI/ML, simulation and replay, dashboard.">
  <PageHead img="runway-night" title="The problem, and where we answer it" lead="Engine monitoring on UAVs mostly raises an alarm after a limit is crossed. Problem Statement 26054 asks for a digital twin that sees trouble coming, on a MALE UAV's piston engine. This page maps every requirement to our work." />

  <section class="section">
    <div class="wrap split">
      <div class="stack">
        <h2 class="display" style="font-size:var(--step-3)">Why it matters</h2>
      </div>
      <div class="prose">
        <p><Term t="MALE" /> UAVs fly long surveillance, relay and patrol missions on a single piston engine. If it fails in flight the mission is lost and the aircraft may be too.</p>
        <p>Today's monitoring is threshold-based: it reports a problem once a value is already out of range. It cannot estimate remaining life, show a trend, or play a mission forward under different conditions.</p>
        <p>The statement asks for an indigenous digital twin for the ground control and health-monitoring chain: real-time state estimation, anomaly detection, degradation tracking, fault prediction and mission replay.</p>
      </div>
    </div>
  </section>

  <section class="section" id="coverage">
    <div class="wrap stack">
      <h2 class="display" style="font-size:var(--step-3)">Requirement coverage</h2>
      <p class="lead">Each row says honestly how far we are. <Stamp status="impl" /> runs in our MATLAB/Simulink work today. <Stamp status="partial" /> exists in part. <Stamp status="design" /> is architecture we have specified but not yet built.</p>
      <div class="table-scroll">
        <table class="data-table coverage">
          <thead><tr><th>Requirement</th><th>Status</th><th>Where and how</th></tr></thead>
          {coverage.map(g => (
            <tbody>
              <tr class="group"><th colspan="3" scope="colgroup">{g.group}</th></tr>
              {g.items.map(i => (
                <tr>
                  <td>{i.req}</td>
                  <td><Stamp status={i.status} /></td>
                  <td>{i.where} <a href={i.href} class="see">See it<Icon name="arrow-right" /></a></td>
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </div>
  </section>

  <section class="section" id="sensors">
    <div class="wrap stack">
      <h2 class="display" style="font-size:var(--step-3)">The parameters we monitor</h2>
      <p class="lead">Requirement B lists eight engine parameters. Six are signals on our simulated <Term t="CAN" /> bus today; two are partial and one is missing.</p>
      <div class="table-scroll">
        <table class="data-table">
          <thead><tr><th>Parameter</th><th>Signal</th><th>CAN message</th><th>Status</th><th>Note</th></tr></thead>
          <tbody>
            {sensors.map(s => (
              <tr><td>{s.param}</td><td class="num">{s.signal}</td><td class="num">{s.can}</td><td><Stamp status={s.status} /></td><td>{s.note}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" id="faults">
    <div class="wrap stack">
      <h2 class="display" style="font-size:var(--step-3)">The faults we can create</h2>
      <p class="lead">Requirement C names eight fault classes. Our simulation's fault library has 52 fault types that cover all eight, so each can be injected into a mission and studied. Detecting them automatically is the job of the designed Edge AI chain.</p>
      <div class="table-scroll">
        <table class="data-table">
          <thead><tr><th>Fault class</th><th>Library fault types</th><th>Signals it moves</th></tr></thead>
          <tbody>
            {faults.map(f => <tr><td>{f.cls}</td><td class="num lib">{f.lib}</td><td>{f.signals}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p class="muted">Injection: <Stamp status="impl" /> · Automated detection: <Stamp status="design" /></p>
    </div>
  </section>

  <div class="wrap"><a class="next-link" href="/how-it-works/"><span>Next</span><strong>How it works</strong></a></div>
</Base>
<style>
  .coverage .group th { padding-top: var(--s-6); font-size: 1rem; color: var(--ink); border-bottom-color: var(--line-strong); font-weight: 640; }
  .coverage td:first-child { width: 34%; }
  .coverage td:nth-child(2) { width: 12rem; }
  .see { display: inline-flex; align-items: center; gap: 0.3em; white-space: nowrap; margin-left: 0.4em; font-weight: 560; }
  .see :global(svg) { width: 14px; height: 14px; }
  .lib { font-size: 0.72rem; word-break: break-word; max-width: 30ch; }
</style>
