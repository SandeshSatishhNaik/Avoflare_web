---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" theme="dark" description="This page does not exist.">
  <section class="section">
    <div class="wrap stack">
      <p class="num muted">404 · signal missing</p>
      <h1 class="display" style="font-size:var(--step-4)">No frame on this address.</h1>
      <p class="lead">The page you asked for does not exist. Start from the mission, or open the replay.</p>
      <p style="display:flex;gap:var(--s-3);flex-wrap:wrap"><a class="btn btn-primary" href="/">Go to the home page</a><a class="btn" href="/demo/">Open the replay</a></p>
    </div>
  </section>
</Base>
