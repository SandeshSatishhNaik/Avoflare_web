---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Stamp from '../components/Stamp.astro';

const plan = [
  ['Physics', 'Compare simulated power, torque, fuel flow and temperatures with VRDE 180 HP and AE300 reference data across the operating envelope.', 'design'],
  ['Sensors', 'Check each simulated sensor for range, noise and response time against its specification.', 'design'],
  ['CAN', 'Round-trip every frame (encode, transmit, decode) and compare with the source values; check freshness and status handling.', 'partial'],
  ['Faults', 'For each of the 52 fault types, confirm the affected signals move in the expected direction and by a plausible amount.', 'partial'],
  ['AI', 'Train and test the detection chain on labelled simulated runs; report detection delay, false alarms and misses per fault class.', 'design'],
  ['Remaining useful life', 'Only after a validated lifetime model exists; until then RUL stays empty in the data.', 'design'],
] as const;

const known = [
  ['Healthy-reference torque and brake power are zero in the current V4 runs.', 'Those channels are hidden on this site until the reference is fixed.'],
  ['Mass airflow reads zero, and boost pressure does not change under compressor wear.', 'Intake and turbocharger coupling needs checking; boost and airflow are not shown.'],
  ['Oil pressure, vibration and voltage are constant in the current runs.', 'Shown as readings, not used as evidence.'],
  ['Some fault runs do not activate their fault (for example one ignition-timing-drift run).', 'Only runs where the fault is active are used here.'],
];
---
<Base title="Validation" description="What AVOFLARE has checked, the known issues in the current simulation data, and the validation plan for physics, sensors, CAN, faults and AI.">
  <PageHead img="runway-blue" title="What we have checked, and what we have not" lead="A digital twin is only as useful as the evidence that it matches the real engine. We have not yet validated against reference engine data. This page says exactly where we stand." />

  <section class="section">
    <div class="wrap split">
      <div class="stack">
        <h2 class="display" style="font-size:var(--step-3)">Known issues in today's data</h2>
        <p class="lead">Found while preparing this site. We show only what survives these issues.</p>
      </div>
      <div class="table-scroll">
        <table class="data-table">
          <thead><tr><th>Issue</th><th>What we did</th></tr></thead>
          <tbody>{known.map(([a, b]) => <tr><td>{a}</td><td>{b}</td></tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap stack">
      <h2 class="display" style="font-size:var(--step-3)">Validation plan</h2>
      <div class="table-scroll">
        <table class="data-table">
          <thead><tr><th>Layer</th><th>Check</th><th>Status</th></tr></thead>
          <tbody>{plan.map(([a, b, c]) => <tr><td>{a}</td><td>{b}</td><td><Stamp status={c} /></td></tr>)}</tbody>
        </table>
      </div>
      <p class="muted">CAN and fault checks are "partly implemented": validation scripts exist in the simulation repository; systematic results are not yet published.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="stack">
        <h2 class="display" style="font-size:var(--step-3)">What is solid today</h2>
      </div>
      <ul class="solid">
        <li>Fault injection works and is traceable: every run records fault type, category, start time and severity alongside the physics.</li>
        <li>Every faulted run carries a healthy reference of the same mission, so divergence is computed point by point.</li>
        <li>Divergence grows with severity in the turbocharger-wear series: +2.1, +8.5 and +10.6 °C EGT at 10, 40 and 50 % wear.</li>
        <li>The CAN layer produces real 8-byte frames for 17 message IDs from the simulated signals.</li>
      </ul>
    </div>
  </section>

  <div class="wrap"><a class="next-link" href="/roadmap/"><span>Next</span><strong>Roadmap</strong></a></div>
</Base>
<style>
  .solid { list-style: none; border-top: 1px solid var(--line); }
  .solid li { padding: var(--s-4) 0; border-bottom: 1px solid var(--line); max-width: 62ch; }
</style>
